#!/bin/bash

# 1. Intentar obtener la IP de interfaces de túnel (VPN: tun0, tun1, wg0, etc.)
IP_VPN=$(ip -4 -o addr show 2>/dev/null | grep -E 'tun[0-9]+|wg[0-9]+' | awk '{print $4}' | cut -d/ -f1 | head -n 1)

if [ -n "$IP_VPN" ]; then
    echo "$IP_VPN"
    exit 0
fi

# 2. Buscar explícitamente la interfaz física enp0s31f6 usando el formato de una línea (-o)
IP_ENP=$(ip -4 -o addr show dev enp0s31f6 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)

if [ -n "$IP_ENP" ]; then
    echo "$IP_ENP"
    exit 0
fi

# 3. Si no hay VPN ni la interfaz específica, buscar la interfaz que tiene la ruta por defecto (Internet real)
INTERFACE_DEFAULT=$(ip route 2>/dev/null | grep default | awk '{print $5}' | head -n 1)

if [ -n "$INTERFACE_DEFAULT" ]; then
    IP_LOCAL=$(ip -4 -o addr show dev "$INTERFACE_DEFAULT" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
    if [ -n "$IP_LOCAL" ]; then
        echo "$IP_LOCAL"
        exit 0
    fi
fi

# 4. Fallback: hostname -I (por si lo anterior falla en casos raros)
IP_FALLBACK=$(hostname -I 2>/dev/null | awk '{print $1}')

if [ -n "$IP_FALLBACK" ]; then
    echo "$IP_FALLBACK"
else
    echo "Sin conexión"
fi
